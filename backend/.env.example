# --- Chat LLM: a loop of free HuggingFace-hosted open models (via HF Inference
# Providers) is primary - get a token at huggingface.co/settings/tokens ---
HF_TOKEN=hf_...

# --- Embeddings: Gemini's free tier, primary for everything embeddings-related ---
GEMINI_API_KEY=AIza...

# --- Chat LLM fallback tiers, tried after every HF model: Gemini, then Groq's
# Qwen3. (Groq has no embeddings endpoint - the embeddings fallback is a local
# FastEmbed model instead, no key needed) ---
GROQ_API_KEY=gsk_...

# --- Web search fallback for INCORRECT / AMBIGUOUS verdicts ---
TAVILY_API_KEY=tvly-...

# --- Vector store ---
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX_NAME=clarity-crag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Observability (optional but recommended) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=Clarity CRAG

# --- Model + pipeline tuning (optional, defaults shown) ---
EMBEDDING_MODEL=models/gemini-embedding-001
FALLBACK_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-small-en
EMBEDDING_DIMENSION=512
# Chat LLM fallback loop, tried in order: HF_CHAT_MODELS (comma-separated) -> CHAT_MODEL
# (Gemini) -> FALLBACK_CHAT_MODEL (Groq)
HF_CHAT_MODELS=meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen2.5-72B-Instruct,meta-llama/Llama-3.1-70B-Instruct
CHAT_MODEL=gemini-2.5-flash
FALLBACK_CHAT_MODEL=qwen/qwen3-32b
UPPER_TH=0.7
LOWER_TH=0.3
RETRIEVER_K=4

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173
