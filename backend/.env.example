# --- LLM + embeddings: Gemini 2.5 Flash (free tier), primary for everything ---
GEMINI_API_KEY=AIza...

# --- LLM fallback: Groq's Qwen3, used only when Gemini errors/rate-limits ---
# (Groq has no embeddings endpoint - the embeddings fallback is a local
# FastEmbed model instead, no key needed)
GROQ_API_KEY=gsk_...

# --- Web search fallback for INCORRECT / AMBIGUOUS verdicts ---
TAVILY_API_KEY=tvly-...

# --- Vector store ---
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX_NAME=clarity-crag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Observability (optional but recommended) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=Clarity CRAG

# --- Model + pipeline tuning (optional, defaults shown) ---
EMBEDDING_MODEL=models/gemini-embedding-001
FALLBACK_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-small-en
EMBEDDING_DIMENSION=512
CHAT_MODEL=gemini-2.5-flash
FALLBACK_CHAT_MODEL=qwen/qwen3-32b
UPPER_TH=0.7
LOWER_TH=0.3
RETRIEVER_K=4

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173
